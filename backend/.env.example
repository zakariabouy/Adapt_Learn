# Database & Cache
DATABASE_URL=postgresql://adaptlearn:adaptlearn_dev@localhost:5432/adaptlearn
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=yoursupersecretkeyhere
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services
GOOGLE_API_KEY=your_google_api_key
GOOGLE_API_KEY_2=                       # optional — pooled by RotatingLLM
GOOGLE_API_KEY_3=                       # optional — pooled by RotatingLLM
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Text-to-image (Hugging Face Inference API — FLUX.1-schnell by default)
# When set, /student/workspace/<id>/visual/<i> returns a real PNG instead of
# Gemini-drawn SVG. Falls back to SVG on any failure.
HF_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Application Settings
ENVIRONMENT=development
PORT=8000

